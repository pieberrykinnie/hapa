# Vapi public key (safe for client-side use) — https://dashboard.vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Groq API key for photo-vibe analysis (server-only) — https://console.groq.com
GROQ_API_KEY=

# Vision model used for photo-vibe analysis — matches SPEC.md's declared choice
PHOTO_MODEL=qwen/qwen3.6-27b

# Sentry DSN for server-side error capture (server-only) — https://sentry.io
SENTRY_DSN=

# Sentry DSN for client-side error capture (a destination identifier, not a secret)
NEXT_PUBLIC_SENTRY_DSN=
